{
  "expo": {
    "name": "Taximeter Pro",
    "slug": "taximeter-pro",
    "version": "1.0.3",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taximeter-pro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "com.taximeter.pro",
      "config": {
        "googleMapsApiKey": "AIzaSyDbIIcl65uaApHjPd1zslTYfVCAuWnIDCM"
      },

      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Taximeter Pro gebruikt uw locatie om uw startlocatie automatisch in te vullen bij het plannen van een rit.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Taximeter Pro gebruikt uw locatie om uw startlocatie automatisch in te vullen bij het plannen van een rit.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbIIcl65uaApHjPd1zslTYfVCAuWnIDCM"
        }
      },
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFD700"
      },
      "package": "com.taximeter_pro",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "name": "Taximeter Pro",
      "shortName": "Taximeter",
      "description": "Professionele ritprijscalculator voor taxichauffeurs. Bereken direct de wettelijke ritprijs op basis van actuele 2026-tarieven.",
      "backgroundColor": "#0a0a0a",
      "themeColor": "#FFD700",
      "lang": "nl",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "indexHtml": "./index.html"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "./plugins/withFixMapsPodfile.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Taximeter Pro gebruikt uw locatie om uw startlocatie automatisch in te vullen bij het plannen van een rit.",
          "locationWhenInUsePermission": "Taximeter Pro gebruikt uw locatie om uw startlocatie automatisch in te vullen bij het plannen van een rit.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "2bdc08c9-5989-4f54-b362-e46236a535fd"
      }
    }
  }
}
